# PowerOrigin environment example

# Database
DATABASE_URL=postgresql://powerorigin:powerorigin@localhost:5432/powerorigin

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production

# CORS
CORS_ORIGIN=http://localhost:3000

# Backend
PORT=4000

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# BOT Chain
BOT_CHAIN_ID=968
BOT_RPC_URL=https://rpc.bohr.life
BOT_EXPLORER_URL=https://scan.bohr.life
DEPLOYER_PRIVATE_KEY=
REGISTRY_ADMIN=
REGISTRY_ADDRESS=

# Integrations (licensed; verify commercial terms before production)
ELECTRICITYMAPS_API_KEY=
GREENWEB_API_KEY=

# Meter vendors (configure per integration)
METER_VENDOR_API_KEY=
